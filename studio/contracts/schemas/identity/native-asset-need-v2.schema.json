{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stickman-native-asset-need-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shot_id",
    "layer_id",
    "expected_path",
    "content",
    "asset_kind",
    "character_ids"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "layer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "expected_path": {
      "type": "string",
      "pattern": "^assets/images/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp)$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "orientation": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "3:4",
        "4:3"
      ]
    },
    "asset_kind": {
      "enum": [
        "background",
        "character",
        "pose",
        "prop",
        "object",
        "other"
      ]
    },
    "character_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^char_[0-9]{3}$"
      }
    },
    "continuity_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "layer_id",
        "relation"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "layer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "relation": {
          "enum": [
            "same_setup",
            "match_subject",
            "match_location",
            "match_composition",
            "graphic_sequence"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "background",
        "preparation",
        "registration"
      ],
      "properties": {
        "composition": {
          "enum": [
            "composed",
            "isolated"
          ]
        },
        "background": {
          "enum": [
            "opaque",
            "transparent"
          ]
        },
        "preparation": {
          "enum": [
            "preserve",
            "border_key"
          ]
        },
        "registration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "key_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}

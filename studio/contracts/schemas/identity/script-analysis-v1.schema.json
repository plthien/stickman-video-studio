{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stickman-script-analysis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "source_script_sha256",
    "source_authoring_sha256",
    "continuity_catalog"
  ],
  "properties": {
    "schema": {
      "const": "stickman-script-analysis-v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "source_script_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_authoring_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "continuity_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "maxItems": 100,
          "uniqueItemProperties": [
            "char_id"
          ],
          "items": {
            "$ref": "#/$defs/character"
          }
        }
      }
    }
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "quote",
        "start",
        "end"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_id",
        "label",
        "description",
        "entity_kind",
        "narrative_role",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "char_id": {
          "type": "string",
          "pattern": "^char_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "entity_kind": {
          "enum": [
            "human_character",
            "human_group"
          ]
        },
        "narrative_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "explicit_visual_traits": {
          "$ref": "#/$defs/traits"
        },
        "identity_markers": {
          "$ref": "#/$defs/traits"
        },
        "continuity_notes": {
          "$ref": "#/$defs/traits"
        },
        "physical_constraints": {
          "$ref": "#/$defs/traits"
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/sourceSpan"
          }
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "visual_trait_evidence": {
          "type": "array",
          "maxItems": 30,
          "uniqueItemProperties": [
            "trait"
          ],
          "items": {
            "$ref": "#/$defs/visualTraitEvidence"
          }
        }
      }
    },
    "traits": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "visualTraitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trait",
        "source",
        "relationship"
      ],
      "properties": {
        "trait": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "$ref": "#/$defs/sourceSpan"
        },
        "relationship": {
          "enum": [
            "intrinsic_appearance",
            "stable_wardrobe",
            "transient_object",
            "transient_action",
            "scene_state",
            "requires_owner_review"
          ]
        }
      }
    }
  }
}

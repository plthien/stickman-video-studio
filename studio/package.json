{
  "name": "mode-b-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5174 && npm run build:electron && node scripts/start-electron-dev.mjs",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ui": "playwright test --reporter=line",
    "accept:r2": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-r2-acceptance.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.4.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.4.0",
    "vite": "6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "1.51.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "concurrently": "9.1.2",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "ffmpeg-static": "^5.3.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "3.0.8",
    "wait-on": "8.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true
  }
}
